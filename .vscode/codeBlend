def extrair_cores_svg_avancado(caminho_arquivo):
    try:
        tree = ET.parse(caminho_arquivo)
        root = tree.getroot()
    except Exception as e:
        print(f"Erro ao ler o arquivo SVG: {e}")
        return []

    # 1. Mapear classes CSS dentro das tags <style> (Muito comum no Illustrator e Corel)
    css_classes = {}
    for elem in root.iter():
        tag_nome = elem.tag.split('}')[-1]
        if tag_nome == 'style' and elem.text:
            # Encontra padrões como: .cls-1 { fill: #ff0000; stroke: #000000; }
            matches = re.finditer(r'\.([a-zA-Z0-9_\-]+)\s*\{([^}]+)\}', elem.text)
            for m in matches:
                nome_classe = m.group(1)
                propriedades = m.group(2)
                
                # \b garante que pegue 'stroke:' e não 'stroke-width:'
                # [^;}] pega tudo até o ponto e vírgula ou fechamento da chave
                fill_m = re.search(r'\bfill\s*:\s*([^;}]+)', propriedades)
                stroke_m = re.search(r'\bstroke\s*:\s*([^;}]+)', propriedades)
                
                css_classes[nome_classe] = {
                    'fill': fill_m.group(1).strip() if fill_m and fill_m.group(1).strip() != 'none' else None,
                    'stroke': stroke_m.group(1).strip() if stroke_m and stroke_m.group(1).strip() != 'none' else None
                }

    dados_objetos = []

    # 2. Iterar sobre os elementos do SVG
    for elem in root.iter():
        tag = elem.tag.split('}')[-1] 
        
        if tag in ['g', 'svg', 'defs', 'style']:
            continue

        id_obj = elem.get('id', 'Objeto_sem_nome')
        
        # Pega atributos diretos primeiro
        fill = elem.get('fill')
        stroke = elem.get('stroke')
        
        # 3. Verifica se o objeto usa alguma classe CSS (ex: class="cls-1")
        classes_obj = elem.get('class', '').split()
        for cls in classes_obj:
            if cls in css_classes:
                if css_classes[cls]['fill']: fill = css_classes[cls]['fill']
                if css_classes[cls]['stroke']: stroke = css_classes[cls]['stroke']

        # 4. Verifica se o objeto tem estilo "inline" (sobrescreve a classe)
        style = elem.get('style', '')
        if style:
            fill_m = re.search(r'\bfill\s*:\s*([^;}]+)', style)
            stroke_m = re.search(r'\bstroke\s*:\s*([^;}]+)', style)
            
            if fill_m and fill_m.group(1).strip() != 'none': 
                fill = fill_m.group(1).strip()
            if stroke_m and stroke_m.group(1).strip() != 'none': 
                stroke = stroke_m.group(1).strip()

        # Filtra os vazios explícitos ("none") que podem vir dos atributos diretos
        if fill == 'none': fill = None
        if stroke == 'none': stroke = None

        if fill or stroke:
            dados_objetos.append({
                'id': id_obj,
                'tipo': tag,
                'preenchimento': fill if fill else 'Nenhum',
                'contorno': stroke if stroke else 'Nenhum'
            })
            
    return dados_objetos

 # --- FUNÇÃO DE CONVERSÃO DE COR ---

def hex_para_rgba(hex_color, alpha=1.0):
    """Converte cor Hex (ex: #ff0000) para Linear RGBA usado no Blender."""
    if not hex_color or not hex_color.startswith('#'):
        return (1.0, 1.0, 1.0, alpha)
        
    hex_color = hex_color.lstrip('#').lower()
    
    r = int(hex_color[0:2], 16) / 255.0
    g = int(hex_color[2:4], 16) / 255.0
    b = int(hex_color[4:6], 16) / 255.0
    
    def srgb_para_linear(c):
        if c <= 0.04045: return c / 12.92
        else: return ((c + 0.055) / 1.055) ** 2.4
        
    return (srgb_para_linear(r), srgb_para_linear(g), srgb_para_linear(b), alpha)


