import bpy
import xml.etree.ElementTree as ET
import re
import os

# --- 1. REGRAS DE MATERIAIS (BASEADO NO CONTORNO) ---
REGRAS_MATERIAIS = {    
    '#ed3237': { 
        'nome_material': 'Acrilico',
        'extrusao': 0.001,      # 1mm (Blender faz para os dois lados = 2mm)
        'roughness': 0.05,      # Bem liso e reflexivo
        'transmission': 1.0     # Transparente
    },
    '#fefefe': { 
        'nome_material': 'MDF',
        'extrusao': 0.003,     # 1.5mm (Blender faz para os dois lados = 3mm)
        'roughness': 0.9,       # Fosco
        'transmission': 0.0     # Opaco
    },
    '#ec268F': { 
        'nome_material': 'Adesivo',
        'extrusao': 0.00005,    # Espessura de papel/adesivo
        'roughness': 0.4,       # Leve brilho
        'transmission': 0.0     # Opaco
    }
}

# --- 2. FUNÇÃO DE CONVERSÃO DE COR ---
def hex_para_rgba(hex_color, alpha=1.0):
    """Converte cor Hex do SVG para o Linear RGBA do Blender."""
    if not hex_color or not hex_color.startswith('#'):
        return (1.0, 1.0, 1.0, alpha)
    
    hex_color = hex_color.lstrip('#').lower()
    r = int(hex_color[0:2], 16) / 255.0
    g = int(hex_color[2:4], 16) / 255.0
    b = int(hex_color[4:6], 16) / 255.0
    
    def srgb_para_linear(c):
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
        
    return (srgb_para_linear(r), srgb_para_linear(g), srgb_para_linear(b), alpha)

## --- 3. PIPELINE PRINCIPAL ---
def automatizar_trofeu_svg(caminho_svg):
    ET.register_namespace('', "http://www.w3.org/2000/svg")
    try:
        tree = ET.parse(caminho_svg)
        root = tree.getroot()
    except Exception as e:
        print(f"Erro ao ler SVG: {e}")
        return
    
    dados_extraidos = {}
    contador = 1
    
    # PASSO A: Ler o SVG e salvar as cores (O Python salva na ordem exata de baixo pra cima do SVG)
    for elem in root.iter():
        tag = elem.tag.split('}')[-1]
        if tag in ['g', 'svg', 'defs', 'style']: continue
            
        id_obj = elem.get('id')
        if not id_obj:
            id_obj = f"trofeu_shape_{contador}"
            elem.set('id', id_obj)
        contador += 1
        
        style = elem.get('style', '')
        fill = elem.get('fill', None)
        stroke = elem.get('stroke', None)
        
        if style:
            fill_match = re.search(r'fill:\s*([^;]+)', style)
            stroke_match = re.search(r'stroke:\s*([^;]+)', style)
            if fill_match and fill_match.group(1) != 'none': fill = fill_match.group(1).strip()
            if stroke_match and stroke_match.group(1) != 'none': stroke = stroke_match.group(1).strip()

        
        
        if fill or stroke:
            dados_extraidos[id_obj] = {
                'preenchimento': fill if fill else 'Nenhum',
                'contorno': stroke if stroke else 'Nenhum'
            }
        
        # Limpa os strokes para não duplicar curvas
        if 'stroke' in elem.attrib: del elem.attrib['stroke']
        if 'stroke-width' in elem.attrib: del elem.attrib['stroke-width']
        if style: elem.set('style', re.sub(r'stroke-[^;]+;?|stroke:[^;]+;?', '', style))
            
    # PASSO B: Salvar temporário limpo e instanciar
    
    caminho_temp = os.path.join(os.path.dirname(caminho_svg), "temp_import.svg")
    tree.write(caminho_temp)
    
    objetos_antes = set(bpy.context.scene.objects)
    

    bpy.ops.object.select_all(action='DESELECT')
    bpy.ops.import_curve.svg(filepath=caminho_temp)

    objetos_depois = set(bpy.context.scene.objects)
    bpy.ops.object.origin_set(type='ORIGIN_GEOMETRY', center='MEDIAN')
    # 4. Subtrai os objetos antigos dos novos. O que sobrar são APENAS os objetos do SVG!
    objetos_importados = list(objetos_depois - objetos_antes)
   
    # 5. Seleciona manualmente cada um deles no contexto do Blender para o Passo C funcionar
    for obj in objetos_importados:
        obj.select_set(True)   
   
    print(bpy.context.selected_objects.__len__(), " objetos importados do SVG.")
   
    # era pra converter em mash para dar espessura.
    if objetos_importados:
        print('objetos importados:', [obj.name for obj in objetos_importados])
        bpy.context.view_layer.objects.active = objetos_importados[0]
        bpy.ops.object.convert(target='MESH')


    # PASSO D: Dar Espessura, Material e Empilhar no Eixo Z
    altura_z_atual = 0.0 # Começamos no chão (Z = 0)
    
    # Colocando os itens da lista na mesma ondem
    for nome_base, dados in dados_extraidos.items():
        print('ordem de entrada nº', list(dados_extraidos.keys()).index(nome_base) + 1, ':', nome_base, dados)
        # Encontra o objeto correspondente no Blender
        obj = next((o for o in objetos_importados if o.name.split('.')[0] == nome_base), None)
        
        if not obj: continue
        cor_contorno = dados['contorno'].lower() if dados['contorno'] != 'Nenhum' else ''
       
        regra = REGRAS_MATERIAIS.get(cor_contorno, {
            'nome_material': 'não encontrado', 'extrusao': 0.001, 'roughness': 0.5, 'transmission': 0.0
        })

        print('a regra é ', regra)
        espessura = regra['extrusao']

        # 1. Posicionar no eixo Z para não encavalar
        obj.location[2] = altura_z_atual

        # 2. Aplicar Modificador Solidify (O jeito mais seguro de dar espessura em Mesh)
        mod_solidify = obj.modifiers.new(name="Espessura_3D", type='SOLIDIFY')
        mod_solidify.thickness = espessura
        mod_solidify.offset = 1.0 # Faz a geometria crescer para cima, e não para o meio

        # Aplica (Assa) o modificador para a geometria virar malha definitiva
        bpy.context.view_layer.objects.active = obj
        bpy.ops.object.modifier_apply(modifier=mod_solidify.name)

        # 3. Atualizar a altura Z para a próxima peça ficar em cima dessa
        altura_z_atual += espessura

        # 4. Configurar e aplicar o Material
        obj.data.materials.clear()
        mat = bpy.data.materials.new(name=f"Mat_{regra['nome_material']}_{nome_base}")
        mat.use_nodes = True
        bsdf = mat.node_tree.nodes.get("Principled BSDF")

        if dados['preenchimento'] != 'Nenhum':
            bsdf.inputs['Base Color'].default_value = hex_para_rgba(dados['preenchimento'])

        bsdf.inputs['Roughness'].default_value = regra['roughness']
        
        if 'Transmission Weight' in bsdf.inputs: bsdf.inputs['Transmission Weight'].default_value = regra['transmission']
        elif 'Transmission' in bsdf.inputs: bsdf.inputs['Transmission'].default_value = regra['transmission']

        obj.data.materials.append(mat)
            
    # Limpeza final
    if os.path.exists(caminho_temp):
        os.remove(caminho_temp)
    print("Troféu instanciado, convertido para malha, empilhado em Z e materiais aplicados com sucesso!")
    
