import bpy
import xml.etree.ElementTree as ET
import re
import os

def importar_svg_limpo(caminho_svg):
    # 1. Prepara o parser e mantém o formato correto do SVG
    ET.register_namespace('', "http://www.w3.org/2000/svg")
    try:
        tree = ET.parse(caminho_svg)
        root = tree.getroot()
    except Exception as e:
        print(f"Erro ao ler SVG: {e}")
        return
    
    dados_extraidos = {}
    contador = 1
    
    # 2. Iterar sobre o SVG para extrair dados e limpar os contornos
    for elem in root.iter():
        tag = elem.tag.split('}')[-1]
        if tag in ['g', 'svg', 'defs', 'style']:
            continue
            
        # Garante que TODO objeto tenha um ID. O Blender usa o ID como nome do objeto!
        id_obj = elem.get('id')
        if not id_obj:
            id_obj = f"svg_shape_{contador}"
            elem.set('id', id_obj)
        contador += 1
        
        style = elem.get('style', '')
        fill = elem.get('fill', None)
        stroke = elem.get('stroke', None)
        
        # Extrair cores do atributo style (se existirem lá)
        if style:
            fill_match = re.search(r'fill:\s*([^;]+)', style)
            stroke_match = re.search(r'stroke:\s*([^;]+)', style)
            if fill_match and fill_match.group(1) != 'none': 
                fill = fill_match.group(1).strip()
            if stroke_match and stroke_match.group(1) != 'none': 
                stroke = stroke_match.group(1).strip()
        
        # Salva as cores no nosso dicionário usando o ID como chave
        if fill or stroke:
            dados_extraidos[id_obj] = {
                'preenchimento': fill if fill else 'Nenhum',
                'contorno': stroke if stroke else 'Nenhum'
            }
        
        # 3. O TRUQUE: Remover o stroke (contorno) para o Blender não duplicar o objeto
        if 'stroke' in elem.attrib:
            del elem.attrib['stroke']
        if 'stroke-width' in elem.attrib:
            del elem.attrib['stroke-width']
        if style:
            # Remove o stroke de dentro da string do style
            novo_style = re.sub(r'stroke:[^;]+;?', '', style)
            novo_style = re.sub(r'stroke-width:[^;]+;?', '', novo_style)
            elem.set('style', novo_style)
            
    # 4. Salvar um SVG temporário sem os contornos
    pasta = os.path.dirname(caminho_svg)
    caminho_temp = os.path.join(pasta, "temp_import.svg")
    tree.write(caminho_temp)
    
    # 5. Importar o SVG temporário no Blender
    # Importante desmarcar a seleção atual para focar só no que for importado
    bpy.ops.object.select_all(action='DESELECT')
    bpy.ops.import_curve.svg(filepath=caminho_temp)
    
    # 6. Processar os objetos que acabaram de ser importados
    objetos_importados = bpy.context.selected_objects
    
    print("\n--- Objetos Importados e Dados Vinculados ---")
    for obj in objetos_importados:
        # O Blender às vezes adiciona .001 no nome, vamos pegar o nome base (que é o ID)
        nome_base = obj.name.split('.')[0] 
        
        if nome_base in dados_extraidos:
            dados = dados_extraidos[nome_base]
            print(f"Objeto Blender: {obj.name}")
            print(f"  -> Material a criar (Contorno SVG): {dados['contorno']}")
            print(f"  -> Cor do Material (Preenchimento SVG): {dados['preenchimento']}\n")
            
            # --- AQUI COMEÇA A SUA MAGIA 3D ---
            # Exemplo: Dar espessura 3D baseada no material
            # if dados['contorno'] == '#ffffff':  # MDF
            #     obj.data.extrude = 0.003  # 3mm
            # elif dados['contorno'] == '#ff0000': # Acrílico
            #     obj.data.extrude = 0.002  # 2mm
            
    # 7. Apagar o arquivo temporário para não sujar o computador
    if os.path.exists(caminho_temp):
        os.remove(caminho_temp)

