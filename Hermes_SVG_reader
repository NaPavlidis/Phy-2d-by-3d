        largura_unidades = max(xs_corpo) - min(xs_corpo)
        altura_unidades = max(ys_corpo) - min(ys_corpo)
    else:
        largura_unidades = 0.0
        altura_unidades = 0.0

    # Fatores de conversão ajustados para corresponder exatamente a 24cm x 30cm
    fator_largura = largura_unidades / 24.0 if largura_unidades > 0 else 42.0
    fator_altura = altura_unidades / 30.0 if altura_unidades > 0 else 42.0

    # Usamos a média dos fatores ou aplicamos a proporção direta
    fator_conversao_cm = (fator_largura + fator_altura) / 2.0

    resultado = {
        "materiais_necessarios": materiais_encontrados,
